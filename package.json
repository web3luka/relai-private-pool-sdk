{
  "name": "@relai-fi/private-pool-sdk",
  "version": "0.0.1-devnet",
  "description": "Client SDK for the RelAI Private Pool V2 — Sapling-style ZK USDC transfers on Solana.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js",
      "require": "./dist/keys.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "require": "./dist/storage.cjs"
    },
    "./encryption": {
      "types": "./dist/encryption.d.ts",
      "import": "./dist/encryption.js",
      "require": "./dist/encryption.cjs"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js",
      "require": "./dist/discovery.cjs"
    },
    "./witness": {
      "types": "./dist/witness.d.ts",
      "import": "./dist/witness.js",
      "require": "./dist/witness.cjs"
    },
    "./prover": {
      "types": "./dist/prover.d.ts",
      "import": "./dist/prover.js",
      "require": "./dist/prover.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web3luka/relai-private-pool-sdk"
  },
  "keywords": [
    "solana",
    "zk",
    "privacy",
    "sapling",
    "joinsplit",
    "usdc",
    "relai"
  ],
  "author": "RelAI",
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "bs58": "^6.0.0",
    "circomlibjs": "^0.1.7"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.95.0",
    "snarkjs": "^0.7.0",
    "tsup": "^8.0.0",
    "typescript": "~5.3.0"
  }
}
